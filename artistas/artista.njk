---
layout: null
pagination:
  data: collections.artistas
  size: 1
  alias: artista
permalink: "/artistas/{{ artista.slug }}/index.html"
---

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/Imagens/favicon.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <title>{{ artista.nome }} - Discografia e Críticas - DiscoAvaliadoBR</title>
    <meta name="description" content="Veja todas as avaliações dos álbuns de {{ artista.nome }}.">

    <meta property="og:type" content="profile">
    <meta property="og:title" content="{{ artista.nome }} no DiscoAvaliadoBR">
    <meta property="og:description" content="Veja as notas e reviews dos álbuns de {{ artista.nome }}">
    <meta property="og:image" content="{{ artista.foto_artista }}">
    <meta property="og:url" content="/artistas/{{ artista.slug }}/">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;600&family=Lora:ital,wght@0,600;1,400&display=swap" rel="stylesheet">

    <style>
        :root {
            --border-color: #e5e2d9;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: #fff;
            color: #111;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 50px;
            border-bottom: 1px solid var(--border-color);
            background: white;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 700;
            cursor: pointer;
            user-select: none;
            text-decoration: none;
            color: inherit;
        }

        nav a {
            margin-left: 28px;
            text-decoration: none;
            color: #222;
            font-weight: 500;
            font-size: 15px;
            transition: 0.2s;
        }

        nav a:hover {
            opacity: 0.6;
        }

        

        .artist-banner {
            height: 420px;
            background: #fff;
            display: flex;
            align-items: flex-end;
            border-bottom: 1px solid #eee;
        }

        .artist-content {
            padding: 60px;
            color: #111;
        }

        .artist-content h1 {
            font-family: 'Playfair Display', serif;
            font-size: 64px;
            margin: 0;
            color: #111;
            text-shadow: none;
            line-height: 1.1;
        }

        .artist-content p {
            font-size: 20px;
            color: #111;
            opacity: 1;
            margin-top: 12px;
        }

        

        .container {
            max-width: 1100px;
            margin: 60px auto;
            padding: 0 20px;
        }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: 32px;
            margin-bottom: 40px;
            border-left: 5px solid #111;
            padding-left: 15px;
            color: #111;
        }

        

        .album-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 25px;
            margin-bottom: 60px;
        }

        .album-card {
            text-decoration: none;
            color: inherit;
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            border: 1px solid #ececec;
            transition: 0.25s ease;
            box-shadow: 0 3px 10px rgba(0,0,0,0.04);
        }

        .album-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.10);
        }

        .album-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block;
        }

        .album-info {
            padding: 14px;
            text-align: center;
        }

        .album-info h3 {
            font-family: 'Playfair Display', serif;
            font-size: 16px;
            margin: 0 0 6px 0;
            color: #111;
        }

        .meta {
            font-size: 12px;
            color: #666;
            margin-top: 4px;
        }

        

        footer {
            margin-top: 100px;
            padding: 60px 20px;
            text-align: center;
            background: #111;
            color: #fff;
            font-family: 'Lora', serif;
            font-size: 16px;
            line-height: 2;
        }

        footer strong {
            font-size: 18px;
            letter-spacing: 0.5px;
        }

        

        @media (max-width: 768px) {

            .artist-banner {
                height: 320px;
            }

            .artist-content {
                padding: 30px;
            }

            .artist-content h1 {
                font-size: 40px;
            }

            .artist-content p {
                font-size: 16px;
            }

            header {
                padding: 15px 25px;
            }
        }
    </style>
</head>

<body>

<header>
    <a href="/" class="logo">DiscoAvaliadoBR</a>
    <nav>
        <a href="/">Início</a>
        <a href="/sobre/">Sobre</a>
    </nav>
</header>

<div class="artist-banner">
    <div class="artist-content">
        <h1>{{ artista.nome }}</h1>

        <p>
            {{ artista.genero_principal }} •
            {{ artista.discos.length }} álbuns avaliados
        </p>
    </div>
</div>

<main class="container">

    <h2>Álbuns Avaliados</h2>

    <div class="album-grid">
        {% for disco in artista.discos | reverse %}

            <a href="{{ disco.url }}" class="album-card">

                <img
                    src="{{ disco.data.imagem }}"
                    alt="{{ disco.data.album }}"
                >

                <div class="album-info">
                    <h3>{{ disco.data.album }}</h3>

                    <div class="meta">
                        {{ disco.data.data_lancamento }}
                    </div>
                </div>

            </a>

        {% endfor %}
    </div>

</main>

<footer>
    <strong>DiscoAvaliadoBR</strong><br>
    © 2026 • Projeto independente de crítica musical brasileira<br>
    Todos os direitos reservados.
</footer>

</body>
</html>
