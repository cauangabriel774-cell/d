---
title: "DiscoAvaliadoBR - Site de críticas de álbuns brasileiros"
---
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="/Imagens/favicon.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <title>{{ title }}</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;600&family=Lora:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
<style>
    :root { --bg: #f8f6f2; --text: #111; }
    body { margin: 0; font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); }
    header { 
        display: flex; 
        justify-content: space-between; 
        align-items: center; 
        padding: 22px 50px;  
        background: #fff; 
        border-bottom: 1px solid var(--border-color); 
        position: sticky; 
        top: 0; 
        z-index: 9999; 
    }
    .logo { 
        font-family: 'Playfair Display', serif; 
        font-size: 26px;  
        font-weight: 700; 
        text-decoration: none; 
        color: var(--text); 
    }
    a { 
        text-decoration: none; 
        color: inherit; 
    }
    .container { 
        max-width: 1100px; 
        margin: 60px auto; 
        padding: 0 20px; 
    }
    .album-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); 
        gap: 25px; 
    }
    .album-card { 
        text-align: center; 
        transition: 0.3s; 
        margin-bottom: 20px; 
    }
    .album-card:hover { 
        transform: translateY(-5px); 
    }
    .album-card img { 
        width: 100%; 
        height: 200px;  
        object-fit: cover; 
        border-radius: 10px; 
        box-shadow: 0 5px 15px rgba(0,0,0,0.08); 
    }
    .album-card h3 { 
        font-family: 'Playfair Display'; 
        font-size: 17px; 
        margin: 12px 0 4px; 
        color: var(--text); 
    }
    .album-card p { 
        margin: 0; 
        font-size: 13px; 
        color: #666; 
    }
    nav a { 
        font-weight: 600; 
        font-size: 14px; 
    }
    .merece-ouvir-header {
        background: #c0392b;
        color: #111;
        display: inline-block;
        padding: 6px 20px;
        border-radius: 6px;
        font-family: 'Playfair Display', serif;
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 25px;
        text-transform: uppercase;
    }
    .merece-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 25px;
        margin-bottom: 60px;
    }
    .merece-card {
        text-align: center;
        transition: 0.3s;
    }
    .merece-card:hover {
        transform: translateY(-5px);
    }
    .merece-card img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    }
    .merece-card h3 {
        font-family: 'Playfair Display';
        font-size: 15px;
        margin: 10px 0 4px;
        color: var(--text);
    }
    .merece-card p {
        margin: 0;
        font-size: 12px;
        color: #666;
    }
    footer {
        margin-top: 100px;
        padding: 60px 20px;
        text-align: center;
        background: #111;
        color: #fff;
        font-family: 'Lora', serif;
        font-size: 16px;
        line-height: 2;
    }
    footer strong {
        font-size: 18px;
        letter-spacing: 0.5px;
    }
</style>
</head>
<body>
<header>
    <a href="/" class="logo">DiscoAvaliadoBR</a>
    <nav>
        <a href="/reviews/">Reviews</a>
        <a href="/sobre/">Sobre</a>
    </nav>
</header>
<main class="container">

    <div class="merece-ouvir-header">Merece Ouvir</div>
    <div class="merece-grid">
        {% for item in collections.top2026 %}
            <a href="{{ item.url }}" class="merece-card">
                <img src="{{ item.data.imagem }}" alt="{{ item.data.album }}">
                <h3>{{ item.data.album }}</h3>
                <p>
                    {% if item.data.artista %}
                        {{ item.data.artista }}
                    {% elif item.data.artistas %}
                        {% for nome in item.data.artistas %}
                            {% if loop.last and not loop.first %}e {{ nome }}{% elif not loop.first %}, {{ nome }}{% else %}{{ nome }}{% endif %}
                        {% endfor %}
                    {% endif %}
                </p>
            </a>
        {% endfor %}
    </div>

    <h2>Críticas recentes</h2>
    <div class="album-grid">
        {% for item in collections.todasReviews %}
            {% if loop.index <= 15 %}
                <a href="{{ item.url }}" class="album-card">
                    <img src="{{ item.data.imagem }}" alt="{{ item.data.album }}">
                    <h3>{{ item.data.album }}</h3>
                    <p>
                        {% if item.data.artista %}
                            {{ item.data.artista }}
                        {% elif item.data.artistas %}
                            {% for nome in item.data.artistas %}
                                {% if loop.last and not loop.first %}e {{ nome }}{% elif not loop.first %}, {{ nome }}{% else %}{{ nome }}{% endif %}
                            {% endfor %}
                        {% endif %}
                    </p>
                </a>
            {% endif %}
        {% endfor %}
    </div>
</main>
<footer>
    <strong>DiscoAvaliadoBR</strong><br>
    © 2026 • Projeto independente de crítica musical brasileira<br>
    Todos os direitos reservados.
</footer>
</body>
</html>
