---
templateEngineOverride: njk, md
---
{% set listaArtistas = artistas or [artista] %}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/Imagens/favicon.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    
    <title>Crítica do álbum {{ album }} - {% for nome in listaArtistas %}{{ nome }}{% if not loop.last %} & {% endif %}{% endfor %}</title>

    <meta name="description" content="Crítica detalhada do álbum {{ album }} de {% for nome in listaArtistas %}{% if loop.last and not loop.first %} e {{ nome }}{% elif not loop.first %}, {{ nome }}{% else %}{{ nome }}{% endif %}{% endfor %}.">
    <meta property="og:title" content="Review: {{ album }} - {% for nome in listaArtistas %}{{ nome }}{% if not loop.last %} & {% endif %}{% endfor %} - DiscoAvaliadoBR">
    <meta property="og:description" content="Crítica completa do álbum {{ album }} de {% for nome in listaArtistas %}{{ nome }}{% if not loop.last %} & {% endif %}{% endfor %}, faixa a faixa, com crítica e contexto.">
    <meta property="og:image" content="https://discoavaliadobr.com.br{{ imagem }}">    
    <meta property="og:url" content="https://discoavaliadobr.com.br{{ page.url }}">    
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="DiscoAvaliadoBR">
    <meta property="article:published_time" content="{{ data_postagem.toISOString() if data_postagem else page.date.toISOString() }}">    
    <meta property="article:author" content="Gabriel Silva">
    <meta property="og:locale" content="pt_BR">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Review: {{ album }} - {% for nome in listaArtistas %}{{ nome }}{% if not loop.last %} & {% endif %}{% endfor %} - DiscoAvaliadoBR">
    <meta name="twitter:description" content="Análise completa do álbum {{ album }} de {% for nome in listaArtistas %}{{ nome }}{% if not loop.last %} & {% endif %}{% endfor %}.">
    <meta name="twitter:image" content="https://discoavaliadobr.com.br{{ imagem }}">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="canonical" href="https://discoavaliadobr.com.br{{ page.url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Inter:wght@300;400;500;600;700&family=Lora:ital,wght@0,600;1,400&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-bg: #f8f6f2;
            --accent-color: #111;
            --border-color: #e5e2d9;
            --text-color: #222;
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: var(--primary-bg);
            color: var(--text-color);
            line-height: 1.8;
            -webkit-font-smoothing: antialiased;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 22px 50px;
            border-bottom: 1px solid var(--border-color);
            background: white;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 26px;
            font-weight: 700;
            text-decoration: none;
            color: inherit;
        }

        nav a {
            margin-left: 28px;
            text-decoration: none;
            color: #222;
            font-weight: 500;
            font-size: 15px;
            transition: 0.2s;
        }

        nav a:hover { opacity: 0.6; }

        .container {
            max-width: 850px;
            margin: 60px auto;
            padding: 0 25px;
        }

        .review-header {
            display: grid;
            grid-template-columns: 280px 1fr auto;
            gap: 40px;
            align-items: center;
            margin-bottom: 50px;
            padding-bottom: 40px;
            border-bottom: 1px solid var(--border-color);
        }

        .album-cover img {
            width: 100%;
            border-radius: 12px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.1);
        }

        .album-data {
            font-size: 14px;
            color: #555;
        }

        .album-data p { margin: 5px 0; }
        .album-data strong { color: #000; }

        /* ESTILO DA NOTA INSPIRADO NA PITCHFORK */
        .score-bloco {
            text-align: center;
            min-width: 120px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .score-numero {
            display: flex;
            flex-direction: column;
            align-items: center;
            line-height: 0.9;
        }

        .score-numero .score-val {
            font-family: 'Playfair Display', serif;
            font-size: 96px; /* Tamanho gigante impactante */
            font-weight: 700;
            font-style: italic; /* Estilo itálico marcante */
            color: var(--accent-color);
        }

        .score-numero .score-dez {
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            color: #777;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 5px;
        }

        .score-rotulo {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-top: 12px;
            padding: 2px 8px;
            border-radius: 3px;
        }

        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 48px;
            margin: 0 0 15px 0;
            line-height: 1.1;
        }

        .artist-link {
            text-decoration: none;
            color: inherit;
            border-bottom: 2px solid transparent;
            transition: 0.3s;
        }

        .artist-link:hover { border-bottom-color: #111; }

        .subtitle {
            font-size: 22px;
            color: #666;
            font-style: italic;
            margin-bottom: 30px;
            display: block;
            line-height: 1.4;
        }

        .meta-info {
            font-size: 12px;
            color: #999;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            margin-bottom: 50px;
        }

        .review-content p {
            margin-bottom: 28px;
            font-size: 18px;
            text-align: justify;
            hyphens: auto;
        }

        .share-buttons {
            margin: 30px 0;
            display: flex;
            gap: 12px;
        }

        .share-buttons a {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            text-decoration: none;
            color: white;
            font-size: 18px;
            transition: 0.2s;
        }

        .share-buttons a:hover { transform: scale(1.1); }
        .share-buttons a:nth-child(1) { background: #25D366; }
        .share-buttons a:nth-child(2) { background: #1877F2; }
        .share-buttons a:nth-child(3) { background: #000000; }

        .tags-container {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px dashed var(--border-color);
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .tag {
            background: #eeebe6;
            color: #555;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: 0.3s;
        }

        .tag:hover { background: var(--accent-color); color: #fff; }

        .bottom-section {
            margin-top: 60px;
            padding-top: 40px;
            border-top: 1px solid var(--border-color);
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: start;
        }

        .artista-bloco { text-align: center; }

        .artista-bloco .album-nome {
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            font-weight: 700;
            color: #111;
            margin-bottom: 12px;
            display: block;
        }

        .artista-bloco img {
            width: 100%;
            max-width: 320px;
            border-radius: 12px;
            box-shadow: 0 15px 45px rgba(0,0,0,0.1);
            margin-bottom: 16px;
        }

        .artista-bloco a.artista-nome {
            font-family: 'Lora', serif;
            font-size: 24px;
            font-weight: 600;
            color: #111;
            text-decoration: none;
            border-bottom: 2px solid transparent;
            transition: 0.3s;
        }

        .artista-bloco a.artista-nome:hover { border-bottom-color: #111; }

        .recentes-bloco h3 {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            margin: 0 0 20px 0;
            color: #111;
        }

        .recentes-lista {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .recentes-lista li {
            border-bottom: 1px solid var(--border-color);
            padding: 12px 0;
        }

        .recentes-lista li:last-child { border-bottom: none; }

        .recentes-lista a {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            color: inherit;
            transition: 0.2s;
        }

        .recentes-lista a:hover { opacity: 0.7; }

        .recentes-lista img {
            width: 52px;
            height: 52px;
            object-fit: cover;
            border-radius: 6px;
            flex-shrink: 0;
        }

        .recentes-lista .info strong {
            display: block;
            font-size: 14px;
            font-family: 'Playfair Display', serif;
        }

        .recentes-lista .info span {
            font-size: 12px;
            color: #888;
        }

        footer {
            margin-top: 100px;
            padding: 60px 20px;
            text-align: center;
            background: #111;
            color: #fff;
            font-family: 'Lora', serif;
            font-size: 16px;
            line-height: 2;
        }

        footer strong { font-size: 18px; letter-spacing: 0.5px; }

        @media (max-width: 768px) {
            .review-header { grid-template-columns: 1fr; text-align: center; gap: 20px; }
            .album-cover { max-width: 200px; margin: 0 auto; }
            h1 { font-size: 34px; }
            header { padding: 15px 25px; }
            .bottom-section { grid-template-columns: 1fr; gap: 40px; }
            .score-numero .score-val { font-size: 80px; }
        }
    </style>
</head>

<body>

<header>
    <a href="/" class="logo">DiscoAvaliadoBR</a>
    <nav>
        <a href="/">Início</a>
        <a href="/reviews/">Reviews</a>
        <a href="/sobre/">Sobre</a>
    </nav>
</header>

<main class="container">

    <div class="review-header">
        <div class="album-cover">
            <img src="{{ imagem }}" alt="Análise e Review do álbum {{ album }} de {% for nome in listaArtistas %}{% if loop.last and not loop.first %} e {{ nome }}{% elif not loop.first %}, {{ nome }}{% else %}{{ nome }}{% endif %}{% endfor %}">
        </div>

        <div class="album-data">
            <p>
                <strong>ARTISTA{% if listaArtistas | length > 1 %}S{% endif %}:</strong>
                {% for nome in listaArtistas %}
                    <a href="/artistas/{{ nome | slugify }}/" class="artist-link">{{ nome }}</a>{% if not loop.last %}{% if loop.revindex == 1 %} e{% else %},{% endif %}{% endif %}
                {% endfor %}
            </p>
            <p><strong>ÁLBUM:</strong> {{ album }}</p>
            <p><strong>LANÇAMENTO:</strong> {{ data_lancamento }}</p>
            <p><strong>GÊNERO:</strong> {{ genero }}</p>
            <p><strong>DURAÇÃO:</strong> {{ duracao }}</p>
        </div>

        <div class="score-bloco" id="score-bloco" data-nota="{{ nota or 0 }}">
            <div class="score-numero">
                <span class="score-val">{{ nota / 10 if nota else "0.0" }}</span>
                <span class="score-dez">NÍVEL / 10</span>
            </div>
            <div class="score-rotulo" id="score-rotulo"></div>
        </div>
    </div>

    <article>
        <h1>
            {{ album }} –
            {% for nome in listaArtistas %}
                {% if not loop.first %}{% if loop.last %} e {% else %}, {% endif %}{% endif %}
                <a href="/artistas/{{ nome | slugify }}/" class="artist-link">{{ nome }}</a>
            </gfor %}
        </h1>

        <span class="subtitle">"{{ frase_impacto }}"</span>

        <div class="share-buttons">
            <a href="#" id="share-wa" target="_blank"><i class="fab fa-whatsapp"></i></a>
            <a href="https://www.facebook.com/sharer/sharer.php?u=https://discoavaliadobr.com.br{{ page.url }}" target="_blank"><i class="fab fa-facebook-f"></i></a>
            <a href="https://twitter.com/intent/tweet?url=https://discoavaliadobr.com.br{{ page.url }}" target="_blank"><i class="fab fa-x-twitter"></i></a>
        </div>

        <div class="meta-info">
            Por Gabriel Silva -
            <time datetime="{{ data_postagem.toISOString() if data_postagem else page.date.toISOString() }}">
                {{ data_postagem | htmlDateString if data_postagem else page.date | htmlDateString }}
            </time>
        </div>

        <div class="review-content">
            {% if conteudo %}
                {{ conteudo | safe }}
            {% else %}
                <p>{{ introducao | safe }}</p>
                <p>{{ analise | safe }}</p>
                <p>{{ conclusao | safe }}</p>
            {% endif %}
        </div>

        <div class="tags-container">
            <span class="tag">review</span>
            <span class="tag">crítica</span>
            <span class="tag">album</span>
            <span class="tag">{{ page.date.getFullYear() }}</span>
            {% for nome in listaArtistas %}
                <span class="tag">{{ nome }}</span>
            {% endfor %}
            <span class="tag">{{ album }}</span>
            <span class="tag">{{ genero }}</span>
        </div>

        <div class="bottom-section">
            <div class="artista-bloco">
                <span class="album-nome">{{ album }}</span>
                <img src="{{ imagem }}" alt="{{ album }}">
                <br>
                {% for nome in listaArtistas %}
                    <a href="/artistas/{{ nome | slugify }}/" class="artista-nome">{{ nome }}</a>
                    {% if not loop.last %}<span> & </span>{% endif %}
                {% endfor %}
            </div>

            <div class="recentes-bloco">
                <h3>Avaliações recentes</h3>
                <ul class="recentes-lista">
                    {% for item in collections.todasReviews %}
                        {% if loop.index <= 5 %}
                            {% if item.data.artistas %}
                                {% set artistasRecentes = item.data.artistas %}
                            {% elif item.data.artista %}
                                {% set artistasRecentes = [item.data.artista] %}
                            {% else %}
                                {% set artistasRecentes = [] %}
                            {% endif %}
                            <li>
                                <a href="{{ item.url }}">
                                    <img src="{{ item.data.imagem }}" alt="{{ item.data.album }}">
                                    <div class="info">
                                        <strong>{{ item.data.album }}</strong>
                                        <span>
                                            {% for nome in artistasRecentes %}
                                                {{ nome }}{% if not loop.last %} & {% endif %}
                                            {% endfor %}
                                        </span>
                                    </div>
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        </div>

    </article>
</main>

<footer>
    <strong>DiscoAvaliadoBR</strong><br>
    © 2026 • Projeto independente de crítica musical brasileira<br>
    Todos os direitos reservados.
</footer>

<script>
    window.addEventListener('load', function() {
        const shareText = encodeURIComponent(document.title + " " + window.location.href);
        const waBtn = document.getElementById('share-wa');
        if (waBtn) waBtn.href = "https://wa.me/?text=" + shareText;

        const bloco = document.getElementById('score-bloco');
        const rotulo = document.getElementById('score-rotulo');
        const nota = parseInt(bloco.dataset.nota) || 0;

        let cor, label;
        if (nota >= 95)      { cor = '#2ecc71'; label = 'Obra-Prima'; }
        else if (nota >= 85) { cor = '#27ae60'; label = 'Excelente'; }
        else if (nota >= 75) { cor = '#f39c12'; label = 'Muito Bom'; }
        else if (nota >= 60) { cor = '#e67e22'; label = 'Bom'; }
        else if (nota >= 40) { cor = '#e74c3c'; label = 'Regular'; }
        else                 { cor = '#c0392b'; label = 'Fraco'; }

        rotulo.style.color = cor;
        rotulo.style.border = "1px solid " + cor; // Dá uma bordinha fina estilo selo
        rotulo.textContent = label;
    });
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Review",
  "image": "https://discoavaliadobr.com.br{{ imagem }}",
  "itemReviewed": {
    "@type": "MusicAlbum",
    "name": "{{ album }}",
    "byArtist": [
      {% for nome in listaArtistas %}
      { "@type": "Person", "name": "{{ nome }}" }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  },
  "author": { "@type": "Person", "name": "Gabriel Silva" },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": "{{ nota / 10 if nota else 0 }}",
    "bestRating": "10",
    "worstRating": "0"
  },
  "publisher": { "@type": "Organization", "name": "DiscoAvaliadoBR" },
  "datePublished": "{{ data_postagem.toISOString() if data_postagem else page.date.toISOString() }}"
}
</script>

</body>
</html>
